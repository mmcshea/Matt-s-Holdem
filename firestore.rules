rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roomHostId(roomCode) {
      return get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostId;
    }

    match /rooms/{roomCode} {
      // Anyone signed in can read public table state (community cards, pot,
      // player stacks/bets/status - never hole cards, those live elsewhere).
      allow read: if isSignedIn();

      // Only the room's host device may create/update the table doc, and only
      // as itself.
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.hostId == request.auth.uid;
      allow delete: if false;

      // Private hole cards: each player can read only their own; only the
      // host (the dealer) may write them.
      match /private/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == roomHostId(roomCode);
      }

      // Action queue: a player may create only their own action request.
      // The host consumes (deletes) actions after applying them; no one
      // may edit an existing action once submitted.
      match /actions/{actionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.playerId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == roomHostId(roomCode);
      }
    }
  }
}
